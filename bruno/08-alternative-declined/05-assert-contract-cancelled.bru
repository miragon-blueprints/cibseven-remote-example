meta {
  name: Assert the contract was cancelled
  type: http
  seq: 5
}

get {
  url: {{engineRest}}/history/activity-instance?processInstanceId={{processInstanceId}}&activityId=endEvent_contractCancelled
  body: none
  auth: none
}

script:pre-request {
  const pid = bru.getVar('processInstanceId');
  await pollEngine(`/history/activity-instance?processInstanceId=${pid}&activityId=endEvent_contractCancelled`,
    (b) => Array.isArray(b) && b.length >= 1);
}

assert {
  res.status: eq 200
  res.body: length 1
}
