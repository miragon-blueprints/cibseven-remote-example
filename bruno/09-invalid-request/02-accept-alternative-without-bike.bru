meta {
  name: Accept an alternative without naming the bike
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/bike-leasing/123e4567-e89b-12d3-a456-426614174000/clarify-alternative
  body: json
  auth: none
}

body:json {
  {
    "alternativeFound": true
  }
}

assert {
  res.status: eq 400
  res.body.title: eq Invalid request
  res.body.detail: eq An accepted alternative must name the bike
}
