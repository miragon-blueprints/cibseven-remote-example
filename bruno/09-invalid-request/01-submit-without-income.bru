meta {
  name: Submit a request without income
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/bike-leasing
  body: json
  auth: none
}

body:json {
  {
    "customerName": "Nora Noincome",
    "email": "nora@example.com",
    "age": 35,
    "monthlyNetIncome": 0,
    "bikeId": "BIKE-900",
    "bikeModel": "Gravel Explorer 900"
  }
}

assert {
  res.status: eq 400
  res.body.title: eq Invalid request
  res.body.detail: eq Monthly net income must be greater than zero
}
