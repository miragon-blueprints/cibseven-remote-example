meta {
  name: Withdraw the application
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/withdraw
  body: none
  auth: none
}

script:pre-request {
  // Wait for the bike order (and insurance/contract) to complete, so they get compensated by the
  // saga rollback when the application is withdrawn.
  await new Promise((resolve) => setTimeout(resolve, 3000));
}

assert {
  res.status: eq 202
}
