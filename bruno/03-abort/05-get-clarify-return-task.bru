meta {
  name: Find the clarify-return task (in the cancel sub-process)
  type: http
  seq: 5
}

get {
  url: {{engineRest}}/task?processInstanceBusinessKey={{applicationId}}&taskDefinitionKey=userTask_clarifyReturn
  body: none
  auth: none
}

script:pre-request {
  const id = bru.getVar('applicationId');
  await pollEngine(`/task?processInstanceBusinessKey=${id}&taskDefinitionKey=userTask_clarifyReturn`,
    (b) => Array.isArray(b) && b.length >= 1 && b[0].id != null);
}

assert {
  res.status: eq 200
  res.body[0].id: isDefined
}

vars:post-response {
  clarifyReturnTaskId: res.body[0].id
}
