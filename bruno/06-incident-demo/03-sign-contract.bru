meta {
  name: Sign the contract to reach the bike order
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/sign-contract
  body: none
  auth: none
}

script:pre-request {
  // Wait for the async job executor to drive the process to the contract-signature wait state.
  await new Promise((resolve) => setTimeout(resolve, 2500));
}

assert {
  res.status: eq 202
}
