meta {
  name: Submit a request for a bike whose dealer is down
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/bike-leasing
  body: json
  auth: none
}

body:json {
  {
    "customerName": "Ivan Incident",
    "email": "ivan@example.com",
    "age": 35,
    "monthlyNetIncome": 3500.0,
    "bikeId": "BIKE-FAIL",
    "bikeModel": "Dealer Outage Demo"
  }
}

assert {
  res.status: eq 200
  res.body.applicationId: isDefined
}

vars:post-response {
  applicationId: res.body.applicationId
}
