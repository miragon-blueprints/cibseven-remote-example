meta {
  name: Find the signature-deadline timer
  type: http
  seq: 3
}

get {
  url: {{engineRest}}/job?processInstanceId={{processInstanceId}}&activityId=event_signatureDeadline&timers=true
  body: none
  auth: none
}

script:pre-request {
  // Wait for the async job executor to drive the process to the contract-signature wait state.
  await new Promise((resolve) => setTimeout(resolve, 2500));
}

assert {
  res.status: eq 200
  res.body[0].id: isDefined
}

vars:post-response {
  deadlineJobId: res.body[0].id
}
