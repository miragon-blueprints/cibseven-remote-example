meta {
  name: Find the signature-deadline timer
  type: http
  seq: 3
}

get {
  url: {{engineRest}}/job?processInstanceId={{processInstanceId}}&activityId=event_signatureDeadline&timers=true
  body: none
  auth: none
}

script:pre-request {
  const pid = bru.getVar('processInstanceId');
  await pollEngine(`/job?processInstanceId=${pid}&activityId=event_signatureDeadline&timers=true`,
    (b) => Array.isArray(b) && b.length >= 1 && b[0].id != null);
}

assert {
  res.status: eq 200
  res.body[0].id: isDefined
}

vars:post-response {
  deadlineJobId: res.body[0].id
}
