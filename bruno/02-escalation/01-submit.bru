meta {
  name: Submit leasing request
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/bike-leasing
  body: json
  auth: none
}

body:json {
  {
    "customerName": "Bob Slowsign",
    "email": "bob@example.com",
    "age": 35,
    "monthlyNetIncome": 3500.0,
    "bikeId": "BIKE-700",
    "bikeModel": "Aero Road 700"
  }
}

assert {
  res.status: eq 200
  res.body.applicationId: isDefined
}

vars:post-response {
  applicationId: res.body.applicationId
}
