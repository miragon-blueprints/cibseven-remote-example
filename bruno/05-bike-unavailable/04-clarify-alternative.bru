meta {
  name: Clarify an alternative bike (external completion)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/clarify-alternative
  body: json
  auth: none
}

script:pre-request {
  // Wait for the order to find the requested bike unavailable and park on the clarify-alternative user task.
  await new Promise((resolve) => setTimeout(resolve, 3000));
}

body:json {
  {
    "alternativeFound": true,
    "bikeId": "BIKE-900",
    "bikeModel": "Gravel Explorer 900"
  }
}

assert {
  res.status: eq 202
}
