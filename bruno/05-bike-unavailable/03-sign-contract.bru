meta {
  name: Sign the contract
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/sign-contract
  body: none
  auth: none
}

script:pre-request {
  const id = bru.getVar('applicationId');
  await pollApp(`/api/bike-leasing/${id}`, (b, s) => s === 200 && b && b.contractId != null);
}

assert {
  res.status: eq 202
}
