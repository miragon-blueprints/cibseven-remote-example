meta {
  name: Assert the leasing is active
  type: http
  seq: 8
}

get {
  url: {{engineRest}}/history/activity-instance?processInstanceId={{processInstanceId}}&activityId=endEvent_leasingActive
  body: none
  auth: none
}

script:pre-request {
  // The withdrawal-period timer releases into the activateLeasing external task; give the worker time
  // to complete it and the async continuation to reach the leasing-active end event.
  await new Promise((resolve) => setTimeout(resolve, 2500));
}

assert {
  res.status: eq 200
  res.body: length 1
}
