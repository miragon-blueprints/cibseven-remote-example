meta {
  name: The alternative bike was ordered
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}
  body: none
  auth: none
}

script:pre-request {
  const id = bru.getVar('applicationId');
  await pollApp(`/api/bike-leasing/${id}`, (b, s) => s === 200 && b && b.status === "ORDERED" && b.orderId != null);
}

assert {
  res.status: eq 200
  res.body.status: eq ORDERED
  res.body.bikeId: eq BIKE-900
}
