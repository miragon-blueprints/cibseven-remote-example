      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="E01" sourceRef="startEvent_applicationWithdrawn" targetRef="event_reverseApplication" />
      <bpmn:sequenceFlow id="E02" sourceRef="event_reverseApplication" targetRef="serviceTask_sendCancellationConfirmation" />
      <bpmn:sequenceFlow id="Flow_0z1vqev" sourceRef="serviceTask_sendCancellationConfirmation" targetRef="endEvent_applicationCancelled" />
      <bpmn:serviceTask id="serviceTask_sendCancellationConfirmation" name="Send cancellation confirmation" camunda:asyncAfter="true" camunda:type="external" camunda:topic="bikeLeasing.sendCancellationConfirmation">
        <bpmn:incoming>E02</bpmn:incoming>
        <bpmn:outgoing>Flow_0z1vqev</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="endEvent_applicationCancelled" name="Leasing cancelled">
        <bpmn:incoming>Flow_0z1vqev</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="boundary_signatureReminder" name="7 days" cancelActivity="false" attachedToRef="subProcess_concludeContract">
