<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_bike_order" targetNamespace="http://miragon.io/miravelo/bike-order" exporter="Camunda Modeler" exporterVersion="5.20.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:message id="Message_LeasingRequestReceived" name="miravelo.leasingRequestReceived" />
  <bpmn:message id="Message_ContractSigned" name="miravelo.contractSigned" />
  <bpmn:message id="Message_HandoverReported" name="miravelo.handoverReported" />
  <bpmn:message id="Message_ApplicationWithdrawn" name="miravelo.applicationWithdrawn" />
  <bpmn:error id="Error_ApplicationInvalid" name="Application Invalid" errorCode="applicationInvalid" />
  <bpmn:escalation id="Escalation_ContractNotSigned" name="Contract Not Signed" escalationCode="contractNotSigned" />
  <bpmn:process id="bikeLeasingProcess" name="MiraVelo Bike Leasing" isExecutable="true" camunda:historyTimeToLive="P180D">
    <bpmn:startEvent id="startEvent_leasingRequestReceived" name="Leasing request received" camunda:asyncAfter="true">
      <bpmn:extensionElements>
        <!-- The message start event injects these variables. Message start events don't support
             camunda:inputOutput, so they are declared for bpmn-to-code via this extension property. -->
        <camunda:properties>
          <camunda:property name="additionalInputVariables" value="applicationId, bikeId, monthlyNetIncome, age" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0cq39pq</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0233gqq" messageRef="Message_LeasingRequestReceived" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="serviceTask_orderBike" name="Order bike from dealer" camunda:asyncAfter="true" camunda:type="external" camunda:topic="bikeLeasing.orderBike">
      <bpmn:extensionElements>
        <!-- Result variables the orderBikeDelegate writes; declared for bpmn-to-code without a
             self-referential I/O mapping. -->
        <camunda:properties>
          <camunda:property name="additionalOutputVariables" value="orderId, bikeAvailable" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1oudvdg</bpmn:incoming>
      <bpmn:outgoing>Flow_0bgyqyx</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="serviceTask_cancelPolicy" name="Cancel policy" isForCompensation="true" camunda:asyncAfter="true" camunda:type="external" camunda:topic="bikeLeasing.cancelPolicy" />
    <bpmn:endEvent id="endEvent_applicationRejected" name="Application rejected">
      <bpmn:incoming>Flow_054y6af</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="event_handoverReported" name="Handover reported" camunda:asyncAfter="true">
      <bpmn:incoming>Flow_0tjit66</bpmn:incoming>
      <bpmn:outgoing>Flow_0msl1d4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1m0s1ya" messageRef="Message_HandoverReported" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="endEvent_leasingActive" name="Leasing active">
      <bpmn:incoming>Flow_1czyhqn</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="serviceTask_sendRejection" name="Send rejection" camunda:asyncAfter="true" camunda:type="external" camunda:topic="bikeLeasing.sendRejection">
      <bpmn:incoming>Flow_1g1dict</bpmn:incoming>
      <bpmn:incoming>Flow_00bctyk</bpmn:incoming>
      <bpmn:incoming>Flow_0p7ddam</bpmn:incoming>
      <bpmn:outgoing>Flow_054y6af</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="serviceTask_validateApplication" name="Validate application" camunda:asyncAfter="true" camunda:type="external" camunda:topic="bikeLeasing.validateApplication">
      <bpmn:incoming>Flow_0cq39pq</bpmn:incoming>
      <bpmn:outgoing>Flow_08ad25m</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway_isSolvent" name="Solvent?" default="Flow_0dj8bxx">
      <bpmn:incoming>Flow_10dsfgr</bpmn:incoming>
      <bpmn:outgoing>Flow_0dj8bxx</bpmn:outgoing>
      <bpmn:outgoing>Flow_00bctyk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="businessRuleTask_checkCreditRating" name="Check credit rating" camunda:resultVariable="solvent" camunda:decisionRef="checkCreditRating" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_08ad25m</bpmn:incoming>
      <bpmn:outgoing>Flow_10dsfgr</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:subProcess id="subProcess_concludeContract" name="Conclude contract">
      <bpmn:incoming>Flow_0dj8bxx</bpmn:incoming>
      <bpmn:outgoing>Flow_17zd4n8</bpmn:outgoing>
      <bpmn:startEvent id="startEvent_customerEligible" name="Customer eligible">
        <bpmn:outgoing>Flow_1jra6g7</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_1jra6g7" sourceRef="startEvent_customerEligible" targetRef="serviceTask_sendContract" />
      <bpmn:sequenceFlow id="Flow_0ff6219" sourceRef="serviceTask_sendContract" targetRef="gateway_awaitSignature" />
      <bpmn:eventBasedGateway id="gateway_awaitSignature">
        <bpmn:incoming>Flow_0ff6219</bpmn:incoming>
        <bpmn:outgoing>Flow_0ete2ij</bpmn:outgoing>
        <bpmn:outgoing>Flow_1uekrwv</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="event_contractSigned" name="Contract signed" camunda:asyncAfter="true">
        <bpmn:incoming>Flow_0ete2ij</bpmn:incoming>
        <bpmn:outgoing>Flow_0m29pj0</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_1s3mj11" messageRef="Message_ContractSigned" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_0ete2ij" sourceRef="gateway_awaitSignature" targetRef="event_contractSigned" />
      <bpmn:endEvent id="endEvent_contractValid" name="Contract valid">
        <bpmn:incoming>Flow_0m29pj0</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_0m29pj0" sourceRef="event_contractSigned" targetRef="endEvent_contractValid" />
      <bpmn:intermediateCatchEvent id="event_signatureDeadline" name="14 days">
        <bpmn:incoming>Flow_1uekrwv</bpmn:incoming>
        <bpmn:outgoing>Flow_1it2fbs</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_0hpbdck">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_1uekrwv" sourceRef="gateway_awaitSignature" targetRef="event_signatureDeadline" />
      <bpmn:sequenceFlow id="Flow_1it2fbs" sourceRef="event_signatureDeadline" targetRef="endEvent_notSigned" />
      <bpmn:endEvent id="endEvent_notSigned" name="Not signed">
        <bpmn:incoming>Flow_1it2fbs</bpmn:incoming>
        <bpmn:escalationEventDefinition id="EscalationEventDefinition_0wpbfeq" escalationRef="Escalation_ContractNotSigned" />
      </bpmn:endEvent>
      <bpmn:serviceTask id="serviceTask_sendContract" name="Send contract" camunda:asyncAfter="true" camunda:type="external" camunda:topic="bikeLeasing.sendContract">
        <bpmn:incoming>Flow_1jra6g7</bpmn:incoming>
        <bpmn:outgoing>Flow_0ff6219</bpmn:outgoing>
      </bpmn:serviceTask>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_reminder1" sourceRef="boundary_signatureReminder" targetRef="serviceTask_sendReminderMail" />
    <bpmn:sequenceFlow id="Flow_reminder2" sourceRef="serviceTask_sendReminderMail" targetRef="endEvent_prospectReminded" />
    <bpmn:parallelGateway id="gateway_fork">
      <bpmn:incoming>Flow_17zd4n8</bpmn:incoming>
      <bpmn:outgoing>Flow_0ncgjti</bpmn:outgoing>
      <bpmn:outgoing>Flow_0sm2h51</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gateway_join">
      <bpmn:incoming>Flow_13li8f0</bpmn:incoming>
      <bpmn:incoming>Flow_1qm0pcr</bpmn:incoming>
      <bpmn:outgoing>Flow_0tjit66</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="gateway_bikeAvailable" name="Bike available?" default="Flow_1qm0pcr">
      <bpmn:incoming>Flow_0bgyqyx</bpmn:incoming>
      <bpmn:outgoing>Flow_1qm0pcr</bpmn:outgoing>
      <bpmn:outgoing>Flow_0dbz33i</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="userTask_clarifyAlternative" name="Clarify alternative with customer" camunda:asyncAfter="true" camunda:formRef="clarifyAlternativeForm" camunda:formRefBinding="deployment">
      <bpmn:documentation>Completable two ways: a human via the deployed Camunda Form (Tasklist), or a client via POST /api/bike-leasing/{id}/clarify-alternative. The REST path is the recommended one — it routes through the domain (persisting the chosen alternative bike on the aggregate) before completing the task, so the captured data actually reaches the domain model. See "Clarify return with supplier" in cancel-bike-order.bpmn for the form-only anti-pattern where data never leaves the process.</bpmn:documentation>
      <bpmn:extensionElements>
        <!-- The decision the task produces; declared for bpmn-to-code. The Camunda Form
             (camunda:formRef) still renders it in the Tasklist for the human completion path. -->
        <camunda:properties>
          <camunda:property name="additionalOutputVariables" value="alternativeFound" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0dbz33i</bpmn:incoming>
      <bpmn:outgoing>Flow_1q8awsj</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_alternativeFound" name="Alternative found?" default="Flow_162bkdk">
      <bpmn:incoming>Flow_1q8awsj</bpmn:incoming>
      <bpmn:outgoing>Flow_162bkdk</bpmn:outgoing>
      <bpmn:outgoing>Flow_0bmze33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gateway_bikeSourceJoin">
      <bpmn:incoming>Flow_0ncgjti</bpmn:incoming>
      <bpmn:incoming>Flow_162bkdk</bpmn:incoming>
      <bpmn:outgoing>Flow_1oudvdg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="event_triggerReversal" name="Trigger reversal">
      <bpmn:incoming>Flow_0bmze33</bpmn:incoming>
      <bpmn:outgoing>Flow_0zi701m</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_1acwjf2" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="serviceTask_cancelContract" name="Cancel contract" isForCompensation="true" camunda:asyncAfter="true" camunda:type="external" camunda:topic="bikeLeasing.cancelContract" />
    <bpmn:callActivity id="callActivity_cancelBikeOrder" name="Cancel bike order" isForCompensation="true" calledElement="cancelBikeOrder">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="orderId" target="orderId" />
        <camunda:in source="bikeId" target="bikeId" />
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:serviceTask id="serviceTask_issueInsurancePolicy" name="Issue insurance policy" camunda:asyncAfter="true" camunda:type="external" camunda:topic="bikeLeasing.issueInsurancePolicy">
      <bpmn:incoming>Flow_0sm2h51</bpmn:incoming>
      <bpmn:outgoing>Flow_13li8f0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="event_withdrawalPeriodElapsed" name="Await end of withdrawal period">
      <bpmn:incoming>Flow_0msl1d4</bpmn:incoming>
      <bpmn:outgoing>Flow_1czyhqn</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0j3mkdd">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:boundaryEvent id="boundary_compensateContract" name="Compensate contract" attachedToRef="subProcess_concludeContract">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_0v0vumq" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="boundary_contractNotSigned" name="Contract not signed" attachedToRef="subProcess_concludeContract">
      <bpmn:outgoing>Flow_0p7ddam</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="EscalationEventDefinition_1rt6mgy" escalationRef="Escalation_ContractNotSigned" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="boundary_applicationInvalid" name="Application&#10;invalid" attachedToRef="serviceTask_validateApplication">
      <bpmn:outgoing>Flow_1g1dict</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1puuwjw" errorRef="Error_ApplicationInvalid" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="boundary_compensateInsurance" name="Compensate policy" attachedToRef="serviceTask_issueInsurancePolicy">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_1qc5iwc" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="boundary_compensateOrder" name="Compensate order" attachedToRef="serviceTask_orderBike">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_1eokj6r" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_0cq39pq" sourceRef="startEvent_leasingRequestReceived" targetRef="serviceTask_validateApplication" />
    <bpmn:sequenceFlow id="Flow_1oudvdg" sourceRef="gateway_bikeSourceJoin" targetRef="serviceTask_orderBike" />
    <bpmn:sequenceFlow id="Flow_0bgyqyx" sourceRef="serviceTask_orderBike" targetRef="gateway_bikeAvailable" />
    <bpmn:sequenceFlow id="Flow_054y6af" sourceRef="serviceTask_sendRejection" targetRef="endEvent_applicationRejected" />
    <bpmn:sequenceFlow id="Flow_0tjit66" sourceRef="gateway_join" targetRef="event_handoverReported" />
    <bpmn:sequenceFlow id="Flow_0msl1d4" sourceRef="event_handoverReported" targetRef="event_withdrawalPeriodElapsed" />
    <bpmn:sequenceFlow id="Flow_1czyhqn" sourceRef="event_withdrawalPeriodElapsed" targetRef="endEvent_leasingActive" />
    <bpmn:sequenceFlow id="Flow_1g1dict" sourceRef="boundary_applicationInvalid" targetRef="serviceTask_sendRejection" />
    <bpmn:sequenceFlow id="Flow_00bctyk" name="No" sourceRef="gateway_isSolvent" targetRef="serviceTask_sendRejection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!solvent}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0p7ddam" sourceRef="boundary_contractNotSigned" targetRef="serviceTask_sendRejection" />
    <bpmn:sequenceFlow id="Flow_08ad25m" sourceRef="serviceTask_validateApplication" targetRef="businessRuleTask_checkCreditRating" />
    <bpmn:sequenceFlow id="Flow_10dsfgr" sourceRef="businessRuleTask_checkCreditRating" targetRef="gateway_isSolvent" />
    <bpmn:sequenceFlow id="Flow_0dj8bxx" sourceRef="gateway_isSolvent" targetRef="subProcess_concludeContract" />
    <bpmn:sequenceFlow id="Flow_17zd4n8" sourceRef="subProcess_concludeContract" targetRef="gateway_fork" />
    <bpmn:sequenceFlow id="Flow_0ncgjti" sourceRef="gateway_fork" targetRef="gateway_bikeSourceJoin" />
    <bpmn:sequenceFlow id="Flow_0sm2h51" sourceRef="gateway_fork" targetRef="serviceTask_issueInsurancePolicy" />
    <bpmn:sequenceFlow id="Flow_13li8f0" sourceRef="serviceTask_issueInsurancePolicy" targetRef="gateway_join" />
    <bpmn:sequenceFlow id="Flow_1qm0pcr" name="Yes" sourceRef="gateway_bikeAvailable" targetRef="gateway_join" />
    <bpmn:sequenceFlow id="Flow_0dbz33i" name="No" sourceRef="gateway_bikeAvailable" targetRef="userTask_clarifyAlternative">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!bikeAvailable}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1q8awsj" sourceRef="userTask_clarifyAlternative" targetRef="gateway_alternativeFound" />
    <bpmn:sequenceFlow id="Flow_162bkdk" name="Yes" sourceRef="gateway_alternativeFound" targetRef="gateway_bikeSourceJoin" />
    <bpmn:sequenceFlow id="Flow_0bmze33" name="No" sourceRef="gateway_alternativeFound" targetRef="event_triggerReversal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!alternativeFound}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0zi701m" sourceRef="event_triggerReversal" targetRef="endEvent_contractCancelled" />
    <bpmn:endEvent id="endEvent_contractCancelled" name="Contract cancelled">
      <bpmn:incoming>Flow_0zi701m</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_04n84yk" />
    </bpmn:endEvent>
    <bpmn:subProcess id="subProcess_applicationWithdrawn" name="Application withdrawn" triggeredByEvent="true">
      <bpmn:startEvent id="startEvent_applicationWithdrawn" name="Request withdrawn" camunda:asyncAfter="true">
        <bpmn:outgoing>E01</bpmn:outgoing>
        <bpmn:messageEventDefinition id="Msg_AntragZurueckgezogen_d" messageRef="Message_ApplicationWithdrawn" />
