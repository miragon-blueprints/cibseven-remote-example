    </bpmn:endEvent>
    <bpmn:association id="Association_0reycrf" associationDirection="One" sourceRef="boundary_compensateInsurance" targetRef="serviceTask_cancelPolicy" />
    <bpmn:association id="Association_1q9i1wm" associationDirection="One" sourceRef="boundary_compensateContract" targetRef="serviceTask_cancelContract" />
    <bpmn:association id="Association_185chbk" associationDirection="One" sourceRef="boundary_compensateOrder" targetRef="callActivity_cancelBikeOrder" />
  </bpmn:process>
